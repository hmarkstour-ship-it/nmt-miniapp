# Отримай безкоштовний ключ на https://aistudio.google.com/apikey
GEMINI_API_KEY=встав_сюди_свій_ключ

# Токен бота від @BotFather — потрібен, щоб перевіряти, хто саме користувач,
# і зберігати його прогрес/історію завдань
BOT_TOKEN=

# Рядок підключення до безкоштовної Postgres-бази на Supabase
# (Project Settings → Database → Connection string → URI, режим "Transaction pooler")
DATABASE_URL=

PORT=3000

# NMT Engine 3.0 Stage 8 — runtime bank
# Відносний шлях рахується від кореня nmt-math-miniapp.
NMT_OFFLINE_BANK_PATH=generated/nmt-question-bank-v1.json

# За замовчуванням false: тренування і пробний НМТ працюють лише з перевіреного offline bank.
# true вмикає старий детермінований генератор лише як аварійний fallback.
NMT_RUNTIME_FALLBACK=false

# plain — звичайні тренувальні тести без рисунків; visual — тільки з рисунками; any — обидва типи.
NMT_TRAINING_VISUAL_MODE=plain

# Stage 10: set true only after reviewing calibration quality on your real data.
NMT_STAGE10_AUTO_QUARANTINE=false
